# .env.example — WIM Online environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# Values here are dev defaults matching the LXC 106 development instance.

# ── Database (wim-db) ──
POSTGRES_DB=wim_sfa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=wim_postgres_2026

# ── API (wim-api) ──
MIN_VISIT_SECONDS=180

# ── Ports (public) ──
SALES_APP_PORT=8080
ADMIN_PORT=8081

# ── Future integrations (leave blank until needed) ──
FLEETBASE_API_URL=
FLEETBASE_API_KEY=
ODOO_API_URL=
ODOO_API_KEY=
WAREHOUSE_API_URL=
WAREHOUSE_API_KEY=

# ── Production secrets (overridden in .env.prod) ──
# ADMIN_EMAIL=superadmin@wim.local
# ADMIN_PASSWORD=change-me
# SESSION_SECRET=change-me